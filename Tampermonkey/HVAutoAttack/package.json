{
  "name": "hv-auto-attack",
  "private": true,
  "version": "10.0.1",
  "description": "HentaiVerse auto attack userscript (multi-file refactor of [HV]AutoAttack.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-build.mjs",
    "build:fast": "vite build",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"src/**/*.{js,mjs}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,mjs}\"",
    "check": "npm run lint && npm run format:check && node scripts/verify-sloc.mjs && node scripts/check-circular.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/tampermonkey": "^5.0.3",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "happy-dom": "^20.10.2",
    "prettier": "^3.3.3",
    "vite": "^5.4.10",
    "vite-plugin-monkey": "^5.0.6",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
